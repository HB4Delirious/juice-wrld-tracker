<Application x:Class="JuiceTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!-- The Mac app's dark look: Figtree for reading, Permanent Marker for titles, its palette (Theme.cs `JT`). -->
  <Application.Resources>
    <FontFamily x:Key="Body">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
    <SolidColorBrush x:Key="Mist" Color="#FFF6FB" />
    <SolidColorBrush x:Key="Muted" Color="#C3B2E3" />
    <SolidColorBrush x:Key="Lavender" Color="#FF6AD5" />
    <SolidColorBrush x:Key="Raise" Color="#D13A1E6C" />
    <SolidColorBrush x:Key="Line" Color="#33BE96FF" />
    <SolidColorBrush x:Key="Line2" Color="#61D2AAFF" />
    <SolidColorBrush x:Key="Panel" Color="#FF140A2C" />

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="Foreground" Value="{StaticResource Mist}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Buttons: a soft pill; "Link" is text in the accent color; "Plain" has no chrome. -->
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Mist}" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="#26FFFFFF" BorderThickness="0.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#4DFFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#26FFFFFF" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Lavender}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Lavender}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="C" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="C" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Plain" TargetType="Button" BasedOn="{StaticResource Link}">
      <Setter Property="Foreground" Value="{StaticResource Mist}" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Mist}" />
      <Setter Property="CaretBrush" Value="{StaticResource Mist}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Lavender}" />
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Lavender}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented tabs (the song list's All / In your library / …) -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{StaticResource Mist}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="12,4" Margin="1">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#59FFFFFF" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#26FFFFFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Mist}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="{StaticResource Line2}" BorderThickness="1" Background="#1AFFFFFF" VerticalAlignment="Center">
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Lavender}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin scroll bars, like macOS -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="#59FFFFFF" CornerRadius="4" Margin="1" /></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8" />
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb"><Border Background="#59FFFFFF" CornerRadius="4" Margin="1" /></ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="Foreground" Value="{StaticResource Mist}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
    </Style>
  </Application.Resources>
</Application>
