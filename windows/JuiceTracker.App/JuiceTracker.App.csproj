<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app (WPF). Builds on any OS (EnableWindowsTargeting), runs on Windows 10/11. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- for the notification-area icon (new-song alerts) only; its names stay out of the global usings -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JuiceTracker.App</RootNamespace>
    <AssemblyName>JuiceTracker</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Juice Tracker</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- decoding audio for File health (length, damage, loudness) and volume matching, via Windows Media Foundation -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference Include="..\JuiceTracker.Core\JuiceTracker.Core.csproj" />
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
</Project>
