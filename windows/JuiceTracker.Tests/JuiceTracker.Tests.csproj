<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the C# engine against tests/fixtures, like scripts/test-engine.sh does for Swift. No test framework:
       a plain program that prints failures and exits 1. Run it with dotnet run in windows/JuiceTracker.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JuiceTracker.Core\JuiceTracker.Core.csproj" />
  </ItemGroup>
</Project>
